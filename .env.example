# Docker Compose — copy to .env:  cp .env.example .env
COMPOSE_PROJECT_NAME=order-processing-system

POSTGRES_IMAGE=postgres:18-alpine
POSTGRES_DB=order_processing
POSTGRES_USER=ops
POSTGRES_PASSWORD=ops
POSTGRES_PORT=5432

REDIS_IMAGE=redis:7-alpine
REDIS_PORT=6379

APP_PORT=8080

# Spring (Compose service hostnames)
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/order_processing
SPRING_DATASOURCE_USERNAME=ops
SPRING_DATASOURCE_PASSWORD=ops
SPRING_DATA_REDIS_HOST=redis
SPRING_DATA_REDIS_PORT=6379

